{
  "name": "justdrive",
  "version": "0.1.7",
  "type": "module",
  "bin": {
    "justdrive": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && rm -rf ./dist/dashboard-spa && cp -r ../dashboard/dist ./dist/dashboard-spa",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && cp package.json package.json.local && node scripts/clean-pkg-for-publish.cjs",
    "postpublish": "mv package.json.local package.json 2>/dev/null; true"
  },
  "dependencies": {
    "commander": "^12",
    "googleapis": "^144",
    "express": "^4",
    "multer": "^1",
    "open": "^10",
    "ora": "^8",
    "chalk": "^5",
    "cli-table3": "^0.6"
  },
  "devDependencies": {
    "@juststore/dashboard": "workspace:*",
    "@juststore/shared": "workspace:*",
    "tsup": "^8",
    "@types/express": "^4",
    "@types/multer": "^1",
    "@types/node": "^20"
  }
}
